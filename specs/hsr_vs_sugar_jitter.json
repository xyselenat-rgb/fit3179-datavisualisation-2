{
 "data": {
  "url": "dataset/OpenHSR.csv"
 },
 "transform": [
  {
   "filter": "isValid(datum.HSR)"
  },
  {
   "calculate": "({\"meat\": \"Meat & eggs\", \"eggs\": \"Meat & eggs\", \"burger\": \"Meat & eggs\", \"frozen foods\": \"Frozen & ready\", \"pizza\": \"Frozen & ready\", \"sandwich\": \"Frozen & ready\", \"ice cream\": \"Frozen & ready\", \"ice\": \"Frozen & ready\", \"cereals\": \"Cereals & grains\", \"pasta, rice and grains\": \"Cereals & grains\", \"pasta\": \"Cereals & grains\", \"snacks\": \"Snacks & sweets\", \"chips\": \"Snacks & sweets\", \"chocolate\": \"Snacks & sweets\", \"topping\": \"Snacks & sweets\", \"honey\": \"Snacks & sweets\", \"soda\": \"Drinks\", \"juice\": \"Drinks\", \"water\": \"Drinks\", \"coffee\": \"Drinks\", \"drink\": \"Drinks\", \"milk\": \"Dairy\", \"cheese\": \"Dairy\", \"cream\": \"Dairy\", \"yoghurt\": \"Dairy\", \"butter\": \"Dairy\", \"dairy\": \"Dairy\", \"bakery\": \"Bakery\", \"bread\": \"Bakery\"})[lower(trim(datum['Product type']))] || 'Pantry & canned'",
   "as": "group"
  },
  {
   "calculate": "datum.HSR <= 1 ? '0.5–1 ★' : datum.HSR <= 2 ? '1.5–2 ★' : datum.HSR <= 3 ? '2.5–3 ★' : datum.HSR <= 4 ? '3.5–4 ★' : '4.5–5 ★'",
   "as": "band"
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "rn"
    }
   ]
  },
  {
   "calculate": "(abs(sin(datum.rn * 12.9898) * 43758.5453) % 1) - 0.5",
   "as": "jit"
  },
  {
   "filter": "isValid(datum.sugars_g_per_100g)"
  }
 ],
 "width": "container",
 "height": 360,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "params": [
  {
   "name": "grp",
   "value": ""
  }
 ],
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "font": "Archivo",
  "background": null,
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111",
   "domainColor": "#111111",
   "tickColor": "#111111",
   "gridColor": "#00000014",
   "domainWidth": 2,
   "tickWidth": 2
  },
  "legend": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111"
  },
  "header": {
   "labelFont": "Archivo",
   "labelFontWeight": 800,
   "labelFontSize": 13,
   "titleFontSize": 0,
   "labelColor": "#111111",
   "labelAnchor": "start",
   "labelPadding": 6
  }
 },
 "padding": {
  "left": 4,
  "right": 18,
  "top": 6,
  "bottom": 4
 },
 "mark": {
  "type": "circle",
  "stroke": "#111111",
  "strokeWidth": 1,
  "size": 70
 },
 "encoding": {
  "x": {
   "field": "HSR",
   "type": "ordinal",
   "title": "Health Star Rating (stars)",
   "axis": {
    "labelAngle": 0
   }
  },
  "xOffset": {
   "field": "jit",
   "type": "quantitative",
   "scale": {
    "domain": [
     -0.5,
     0.5
    ]
   }
  },
  "y": {
   "field": "sugars_g_per_100g",
   "type": "quantitative",
   "title": "Sugars (g per 100 g, log scale)",
   "scale": {
    "type": "symlog",
    "constant": 1,
    "domain": [
     0,
     100
    ],
    "nice": false
   },
   "axis": {
    "values": [
     0,
     1,
     2,
     5,
     10,
     20,
     50,
     100
    ]
   }
  },
  "color": {
   "field": "band",
   "type": "ordinal",
   "title": "Health Star Rating",
   "scale": {
    "domain": [
     "0.5–1 ★",
     "1.5–2 ★",
     "2.5–3 ★",
     "3.5–4 ★",
     "4.5–5 ★"
    ],
    "range": [
     "#E0245E",
     "#F77F00",
     "#FCBF49",
     "#2A9D8F",
     "#2338D6"
    ]
   },
   "legend": null
  },
  "opacity": {
   "condition": {
    "test": "grp === '' || datum.group === grp",
    "value": 0.95
   },
   "value": 0.12
  },
  "tooltip": [
   {
    "field": "product_name",
    "title": "Product"
   },
   {
    "field": "group",
    "title": "Group"
   },
   {
    "field": "HSR",
    "title": "Stars"
   },
   {
    "field": "sugars_g_per_100g",
    "title": "Sugars g/100 g"
   }
  ]
 }
}