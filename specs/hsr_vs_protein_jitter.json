{
 "data": {
  "url": "../dataset/OpenHSR.csv"
 },
 "transform": [
  {
   "filter": "isValid(datum.HSR)"
  },
  {
   "calculate": "({\"meat\": \"Meat & eggs\", \"eggs\": \"Meat & eggs\", \"burger\": \"Meat & eggs\", \"frozen foods\": \"Frozen & ready\", \"pizza\": \"Frozen & ready\", \"sandwich\": \"Frozen & ready\", \"ice cream\": \"Frozen & ready\", \"ice\": \"Frozen & ready\", \"cereals\": \"Cereals & grains\", \"pasta, rice and grains\": \"Cereals & grains\", \"pasta\": \"Cereals & grains\", \"snacks\": \"Snacks & sweets\", \"chips\": \"Snacks & sweets\", \"chocolate\": \"Snacks & sweets\", \"topping\": \"Snacks & sweets\", \"honey\": \"Snacks & sweets\", \"soda\": \"Drinks\", \"juice\": \"Drinks\", \"water\": \"Drinks\", \"coffee\": \"Drinks\", \"drink\": \"Drinks\", \"milk\": \"Dairy\", \"cheese\": \"Dairy\", \"cream\": \"Dairy\", \"yoghurt\": \"Dairy\", \"butter\": \"Dairy\", \"dairy\": \"Dairy\", \"bakery\": \"Bakery\", \"bread\": \"Bakery\"})[lower(trim(datum['Product type']))] || 'Pantry & canned'",
   "as": "group"
  },
  {
   "window": [
    {
     "op": "row_number",
     "as": "rn"
    }
   ]
  },
  {
   "calculate": "(abs(sin(datum.rn * 12.9898) * 43758.5453) % 1) - 0.5",
   "as": "jit"
  },
  {
   "filter": "isValid(datum.protein_g_per_100g)"
  }
 ],
 "width": "container",
 "height": 360,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "params": [
  {
   "name": "grp",
   "value": ""
  }
 ],
 "layer": [
  {
   "mark": {
    "type": "point",
    "filled": true,
    "stroke": "#111111",
    "strokeWidth": 1,
    "size": 70
   },
   "encoding": {
    "x": {
     "field": "HSR",
     "type": "ordinal",
     "title": "Health Star Rating (stars)",
     "axis": {
      "labelAngle": 0
     }
    },
    "xOffset": {
     "field": "jit",
     "type": "quantitative",
     "scale": {
      "domain": [
       -0.5,
       0.5
      ]
     }
    },
    "y": {
     "field": "protein_g_per_100g",
     "type": "quantitative",
     "title": "Protein (g per 100 g)",
     "scale": {
      "domain": [
       0,
       42
      ],
      "nice": false,
      "clamp": true
     }
    },
    "color": {
     "field": "HSR",
     "type": "quantitative",
     "scale": {
      "type": "linear",
      "domain": [
       0.5,
       1.625,
       2.75,
       3.875,
       5
      ],
      "range": [
       "#E0245E",
       "#F08BA9",
       "#D9D9D0",
       "#8E9AE8",
       "#2338D6"
      ],
      "interpolate": "lab",
      "clamp": true
     },
     "legend": null
    },
    "shape": {
     "field": "group",
     "type": "nominal",
     "scale": {
      "domain": [
       "Meat & eggs",
       "Frozen & ready",
       "Cereals & grains",
       "Snacks & sweets",
       "Drinks",
       "Dairy",
       "Bakery",
       "Pantry & canned"
      ],
      "range": [
       "circle",
       "square",
       "diamond",
       "triangle-up",
       "triangle-down",
       "cross",
       "triangle-right",
       "triangle-left"
      ]
     },
     "legend": null
    },
    "opacity": {
     "condition": {
      "test": "grp === '' || datum.group === grp",
      "value": 0.95
     },
     "value": 0.12
    },
    "tooltip": [
     {
      "field": "product_name",
      "title": "Product"
     },
     {
      "field": "group",
      "title": "Group"
     },
     {
      "field": "HSR",
      "title": "Stars"
     },
     {
      "field": "protein_g_per_100g",
      "title": "Protein g/100 g"
     }
    ]
   }
  },
  {
   "transform": [
    {
     "aggregate": [
      {
       "op": "median",
       "field": "protein_g_per_100g",
       "as": "m"
      }
     ],
     "groupby": [
      "HSR"
     ]
    }
   ],
   "mark": {
    "type": "tick",
    "color": "#111111",
    "thickness": 4,
    "width": 26
   },
   "encoding": {
    "x": {
     "field": "HSR",
     "type": "ordinal"
    },
    "y": {
     "field": "m",
     "type": "quantitative"
    },
    "tooltip": [
     {
      "field": "HSR",
      "title": "Stars"
     },
     {
      "field": "m",
      "title": "Median",
      "format": ".1f"
     }
    ]
   }
  }
 ],
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "font": "Archivo",
  "background": null,
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111",
   "domainColor": "#111111",
   "tickColor": "#111111",
   "gridColor": "#00000014",
   "domainWidth": 2,
   "tickWidth": 2
  },
  "legend": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111"
  },
  "header": {
   "labelFont": "Archivo",
   "labelFontWeight": 800,
   "labelFontSize": 13,
   "titleFontSize": 0,
   "labelColor": "#111111",
   "labelAnchor": "start",
   "labelPadding": 6
  }
 },
 "padding": {
  "left": 4,
  "right": 18,
  "top": 6,
  "bottom": 4
 }
}