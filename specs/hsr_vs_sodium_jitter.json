{
 "data": {
  "url": "dataset/OpenHSR.csv"
 },
 "transform": [
  {
   "filter": "isValid(datum.HSR)"
  },
  {
   "calculate": "({\"meat\": \"Meat & eggs\", \"eggs\": \"Meat & eggs\", \"burger\": \"Meat & eggs\", \"frozen foods\": \"Frozen & ready\", \"pizza\": \"Frozen & ready\", \"sandwich\": \"Frozen & ready\", \"ice cream\": \"Frozen & ready\", \"ice\": \"Frozen & ready\", \"cereals\": \"Cereals & grains\", \"pasta, rice and grains\": \"Cereals & grains\", \"pasta\": \"Cereals & grains\", \"snacks\": \"Snacks & sweets\", \"chips\": \"Snacks & sweets\", \"chocolate\": \"Snacks & sweets\", \"topping\": \"Snacks & sweets\", \"honey\": \"Snacks & sweets\", \"soda\": \"Drinks\", \"juice\": \"Drinks\", \"water\": \"Drinks\", \"coffee\": \"Drinks\", \"drink\": \"Drinks\", \"milk\": \"Dairy\", \"cheese\": \"Dairy\", \"cream\": \"Dairy\", \"yoghurt\": \"Dairy\", \"butter\": \"Dairy\", \"dairy\": \"Dairy\", \"bakery\": \"Bakery\", \"bread\": \"Bakery\"})[lower(trim(datum['Product type']))] || 'Pantry & canned'",
   "as": "group"
  },
  {
   "calculate": "datum.HSR <= 1 ? '0.5–1 ★' : datum.HSR <= 2 ? '1.5–2 ★' : datum.HSR <= 3 ? '2.5–3 ★' : datum.HSR <= 4 ? '3.5–4 ★' : '4.5–5 ★'",
   "as": "band"
  },
  {
   "filter": "isValid(datum.sodium_mg_per_100g)"
  },
  {
   "filter": "grp === '' || datum.group === grp"
  },
  {
   "calculate": "datum.sodium_mg_per_100g <= 120 ? 'Low salt: up to 120 mg' : datum.sodium_mg_per_100g <= 600 ? 'Medium: 121–600 mg' : 'High salt: over 600 mg'",
   "as": "nb"
  },
  {
   "joinaggregate": [
    {
     "op": "count",
     "as": "n"
    }
   ],
   "groupby": [
    "nb"
   ]
  },
  {
   "calculate": "datum.nb + ' (' + datum.n + ')'",
   "as": "nlabel"
  },
  {
   "calculate": "indexof([\"Low salt: up to 120 mg\", \"Medium: 121–600 mg\", \"High salt: over 600 mg\"], datum.nb)",
   "as": "nbo"
  }
 ],
 "width": "container",
 "height": 240,
 "autosize": {
  "type": "fit-x",
  "contains": "padding"
 },
 "params": [
  {
   "name": "grp",
   "value": ""
  }
 ],
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
 "config": {
  "font": "Archivo",
  "background": null,
  "view": {
   "stroke": null
  },
  "axis": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111",
   "domainColor": "#111111",
   "tickColor": "#111111",
   "gridColor": "#00000014",
   "domainWidth": 2,
   "tickWidth": 2
  },
  "legend": {
   "labelFont": "Archivo",
   "titleFont": "Archivo",
   "labelFontSize": 12,
   "titleFontSize": 12,
   "titleFontWeight": 700,
   "labelColor": "#111111",
   "titleColor": "#111111"
  },
  "header": {
   "labelFont": "Archivo",
   "labelFontWeight": 800,
   "labelFontSize": 13,
   "titleFontSize": 0,
   "labelColor": "#111111",
   "labelAnchor": "start",
   "labelPadding": 6
  }
 },
 "padding": {
  "left": 4,
  "right": 18,
  "top": 6,
  "bottom": 4
 },
 "mark": {
  "type": "bar",
  "stroke": "#111111",
  "strokeWidth": 1.5
 },
 "encoding": {
  "y": {
   "field": "nlabel",
   "type": "nominal",
   "title": "Sodium per 100 g",
   "sort": {
    "field": "nbo",
    "op": "min",
    "order": "ascending"
   },
   "axis": {
    "labelFontWeight": 700,
    "labelLimit": 200
   }
  },
  "x": {
   "aggregate": "count",
   "type": "quantitative",
   "stack": "normalize",
   "title": "Share of products in the band",
   "axis": {
    "format": "%",
    "values": [
     0,
     0.25,
     0.5,
     0.75,
     1
    ]
   }
  },
  "color": {
   "field": "band",
   "type": "ordinal",
   "title": "Health Star Rating",
   "scale": {
    "domain": [
     "0.5–1 ★",
     "1.5–2 ★",
     "2.5–3 ★",
     "3.5–4 ★",
     "4.5–5 ★"
    ],
    "range": [
     "#E0245E",
     "#F77F00",
     "#FCBF49",
     "#2A9D8F",
     "#2338D6"
    ]
   },
   "legend": null
  },
  "tooltip": [
   {
    "field": "nb",
    "title": "Band"
   },
   {
    "field": "band",
    "title": "Stars"
   },
   {
    "aggregate": "count",
    "title": "Products"
   }
  ]
 }
}